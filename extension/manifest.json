{
  "manifest_version": 3,
  "name": "Smart Labeling Assistant",
  "version": "1.0.0",
  "description": "Assists with preference labeling tasks using a local Ollama model. Extracts the prompt and images, recommends the better option, and waits for your confirmation.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "http://127.0.0.1:11435/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Labeling Assistant"
  }
}
